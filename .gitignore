# Data and model artifacts (never committed — too large, regenerated by scripts)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test / lint / type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Jupyter
.ipynb_checkpoints/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Kaggle credentials — never committed
kaggle.json
